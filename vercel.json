{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/b2b-salg/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/b2b-salg/sjekk/", "destination": "https://operators-meddic-sjekk.vercel.app/" },
    { "source": "/b2b-salg/sjekk/api/resultat/", "destination": "https://operators-meddic-sjekk.vercel.app/api/resultat" },
    { "source": "/b2b-salg/sjekk/:path*", "destination": "https://operators-meddic-sjekk.vercel.app/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
